<table class="table is-fullwidth">
  <thead>
    <tr>
      <th>Marker</th>
      <th>Location</th>
      <th>Date</th>
      <th>Timestamp</th>
    </tr>
  </thead>
  <tbody>
    {{#each placemark.markers}}
      <tr>
        <td>
          {{title}}
        </td>
        <td>
          {{location}}
        </td>
        <td>
          {{date}}
        </td>
        <td>
          {{timestamp}}
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>